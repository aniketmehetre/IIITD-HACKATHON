# ==============================================================================
# STING Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT commit real secrets or API keys to version control.
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-me-in-production-sting-secret-key-32chars

# TinyFish Infrastructure APIs
# Obtain your key from https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai
TINYFISH_BROWSER_URL=https://api.browser.tinyfish.ai
# Set to true to allow realistic simulated fallback responses when API key is missing or testing
TINYFISH_MOCK_FALLBACK=true

# Database (PostgreSQL via SQLAlchemy asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sting_db
# SQLite fallback for local test without docker:
# DATABASE_URL=sqlite+aiosqlite:///./sting.db

# Message Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Storage / Artifact Paths
EVIDENCE_DIR=./evidence
REPORTS_DIR=./reports
