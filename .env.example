# ==============================================================================
# STING Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# Never commit .env into source control.
# ==============================================================================

# Core Application Settings
STING_ENV=development
STING_API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_DIR=./storage

# TinyFish Web Intelligence & Autonomous Detonation
TINYFISH_API_KEY=
AGENT_DAILY_BUDGET=20
AGENT_MAX_STEPS=40
AGENT_MAX_SECONDS=180
PROXY_COUNTRY=IN
DETONATION_PROFILE=stealth

# Persistence
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/sting_db

# Evidence & Cryptographic Verification
EVIDENCE_SIGNING_KEY=

# Synthetic Victim Identity (Never use real personal data)
SYNTHETIC_NAME=Ramesh Kumar
SYNTHETIC_EMAIL=ramesh.investigation@example.com
SYNTHETIC_PHONE=+919876543210

# Investigation & Correlation Settings
DEMO_REPLAY=false
SITE_REUSE_DAYS=7
PIPELINE_RUNNER=inprocess
